{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "apps-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "apps-dev",
      "displayName": "All standalone apps (development)",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/apps-dev"
    },
    {
      "name": "calendar-dev",
      "displayName": "Calendar only",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/calendar-dev",
      "cacheVariables": {
        "KOS_BUILD_CALENDAR": "ON",
        "KOS_BUILD_TODO": "OFF",
        "KOS_BUILD_WEATHER": "OFF",
        "KOS_BUILD_MUSIC": "OFF"
      }
    },
    {
      "name": "todo-dev",
      "displayName": "Todo only",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/todo-dev",
      "cacheVariables": {
        "KOS_BUILD_CALENDAR": "OFF",
        "KOS_BUILD_TODO": "ON",
        "KOS_BUILD_WEATHER": "OFF",
        "KOS_BUILD_MUSIC": "OFF"
      }
    },
    {
      "name": "weather-dev",
      "displayName": "Weather only",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/weather-dev",
      "cacheVariables": {
        "KOS_BUILD_CALENDAR": "OFF",
        "KOS_BUILD_TODO": "OFF",
        "KOS_BUILD_WEATHER": "ON",
        "KOS_BUILD_MUSIC": "OFF"
      }
    },
    {
      "name": "music-dev",
      "displayName": "Music only",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/music-dev",
      "cacheVariables": {
        "KOS_BUILD_CALENDAR": "OFF",
        "KOS_BUILD_TODO": "OFF",
        "KOS_BUILD_WEATHER": "OFF",
        "KOS_BUILD_MUSIC": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "apps-dev", "configurePreset": "apps-dev" },
    { "name": "calendar-dev", "configurePreset": "calendar-dev" },
    { "name": "todo-dev", "configurePreset": "todo-dev" },
    { "name": "weather-dev", "configurePreset": "weather-dev" },
    { "name": "music-dev", "configurePreset": "music-dev" }
  ],
  "testPresets": [
    {
      "name": "apps-dev",
      "configurePreset": "apps-dev",
      "output": { "outputOnFailure": true }
    }
  ]
}

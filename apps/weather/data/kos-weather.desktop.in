[Desktop Entry]
Version=1.0
Type=Application
Name=KOS Weather
Name[zh_CN]=KOS 天气
GenericName=Weather
GenericName[zh_CN]=天气
Comment=View current conditions and forecasts for saved locations
Comment[zh_CN]=查看已保存地点的实时天气与预报
TryExec=@KOS_APP_EXECUTABLE@
Exec=@KOS_APP_EXECUTABLE@
Icon=kos-weather
Terminal=false
Categories=Utility;Qt;
Keywords=weather;forecast;temperature;
StartupNotify=true
StartupWMClass=kos-weather
X-GNOME-SingleWindow=true
Actions=Settings;

[Desktop Action Settings]
Name=Settings
Name[zh_CN]=设置
Exec=@KOS_APP_EXECUTABLE@ --settings

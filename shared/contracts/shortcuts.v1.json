{
  "version": 1,
  "command": "{qs} -c kos ipc call {target} {action}",
  "shortcuts": [
    {
      "id": "net.local.kos-launcher",
      "description": "应用启动器",
      "target": "applauncher",
      "action": "toggle",
      "default": "Meta+Space"
    },
    {
      "id": "net.local.kos-window-switcher",
      "description": "窗口切换",
      "target": "quicksearch",
      "action": "toggle window",
      "default": "Meta+Shift+Space"
    },
    {
      "id": "net.local.kos-control-center",
      "description": "控制中心",
      "target": "control-center",
      "action": "toggle",
      "default": "Meta+B"
    },
    {
      "id": "net.local.kos-overview",
      "description": "工作区概览",
      "target": "overview",
      "action": "toggle",
      "default": "Meta+Tab"
    },
    {
      "id": "net.local.kos-clipboard",
      "description": "剪贴板历史",
      "target": "quicksearch",
      "action": "toggle clipboard",
      "default": "Meta+V"
    },
    {
      "id": "net.local.kos-show-desktop",
      "description": "显示/返回桌面",
      "target": "desktop",
      "action": "toggle",
      "default": "Meta+D"
    }
  ]
}

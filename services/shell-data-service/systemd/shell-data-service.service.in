[Unit]
Description=NextKde shared desktop data service
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/kos-shell-data-service
Restart=on-failure
RestartSec=2
Slice=background.slice

[Install]
WantedBy=graphical-session.target
